.{
    .name = .auth,
    .version = "0.1.23",
    .fingerprint = 0xf8deb0596799be5b,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Otel observability dep. Lazy: only fetched when the build
        // reaches `b.lazyDependency("otel", ...)` under `-Dwith_otel=true`.
        // With the flag off the dependency is never resolved and the
        // produced artifact contains zero otel symbols (verified by
        // otel/scripts/verify-consumer-noop.sh).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.30#dbf58bae612ef3f5f78c62c130b4c6d63f5aa297",
            .hash = "otel-0.1.30-B0v3lrGuNQDL0D3_KAb6qK6MaYmz2QeutCp0Sg3SL1H7",
            .lazy = true,
        },
        // FIPS-140-3 backend, pinned to a published fips release. Lazy: only
        // resolved when the build reaches `b.lazyDependency("fips", ...)`
        // under `-Dfips=true`; with the flag off the produced artifact links
        // no OpenSSL and contains zero fips symbols.
        .fips = .{
            .url = "git+https://gitlab.com/devnw/zig/fips.git?ref=v0.1.4#b28d7f1d4ea0f0cb7e00d5bdbf3e4c788b1e02fd",
            .hash = "fips-0.1.4-1wf3nXbXCgB1B18pFjHT6l3wK5O09--Ig9DGon7IpzyD",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "examples",
        "LICENSE",
        "README.md",
    },
}
