.{
    .name = .auth,
    .version = "0.1.10",
    .fingerprint = 0xf8deb0596799be5b,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Otel observability dep. Lazy: only fetched when the build
        // reaches `b.lazyDependency("otel", ...)` under `-Dwith_otel=true`.
        // With the flag off the dependency is never resolved and the
        // produced artifact contains zero otel symbols (verified by
        // otel/scripts/verify-consumer-noop.sh).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#v0.1.15",
            .hash = "otel-0.1.15-B0v3lrz2NQDlzY3t-QLNpP4PE3UylgFDF__MoZZTWNJt",
            .lazy = true,
        },
        // FIPS-140-3 backend. Only resolved when the build reaches
        // `b.dependency("fips", ...)` under `-Dfips=true`; with the flag
        // off it is never resolved and the produced artifact links no
        // OpenSSL and contains zero fips symbols.
        //
        // Wired here as a LOCAL PATH dependency because the `fips` package
        // has no git remote yet. Once `fips` is published+tagged, replace
        // this with the lazy git+https form (mirroring the otel entry):
        //
        //     .fips = .{
        //         .url = "git+https://gitlab.com/devnw/zig/fips.git?ref=v0.1.0#<commit-sha>",
        //         .hash = "<zig-package-hash>",
        //         .lazy = true,
        //     },
        //
        // and switch the consumer build.zig back to `b.lazyDependency`.
        //
        // Path is build-root-relative (Zig 0.16 rejects absolute paths).
        // The auth repo's real location is
        // /home/benji/src/gl/gitlab.com/devnw/zig/auth and the fips
        // package lives at /home/benji/src/devnw/zig/fips, so the relative
        // path resolves there.
        .fips = .{
            .url = "git+https://gitlab.com/devnw/zig/fips.git#v0.1.1",
            .hash = "fips-0.1.1-1wf3na01BwC3voljVu61_0g6DXp6BCedXrq4QMuMeQBq",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
